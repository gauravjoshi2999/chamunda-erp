{
  "rules": {
    "chamundaERP": {
      "data": {
        ".read": "auth != null",
        ".write": "auth != null",
        "jcbInbox": {
          ".write": true,
          ".validate": "newData.hasChildren(['date','time','vehicleType','material','_id']) && newData.child('date').isString() && newData.child('time').isString() && newData.child('vehicleType').isString() && newData.child('material').isString() && newData.child('_id').isString()"
        }
      }
    }
  }
}